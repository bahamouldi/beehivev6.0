# =============================================================================
# BeeWAF — Dockerfile PRODUCTION (ML pré-entraîné, single-stage)
#
# Single-stage build to avoid numpy 2.x C extension breakage across stages.
#   1. Installe toutes les dépendances
#   2. Entraîne les modèles ML pendant le build (offline)
#   3. Nettoie les outils de build pour réduire la taille
#   → Les modèles survivent aux redémarrages de pods
# =============================================================================
FROM python:3.11-slim

WORKDIR /app

# Runtime-only deps (numpy/scipy/sklearn ship pre-built manylinux wheels)
# NO build-essential needed → saves 433MB of disk space
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Installer les packages Python (binary wheels only — no compilation)
COPY requirements.txt ./
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir --only-binary=:all: \
    fastapi uvicorn python-multipart aiofiles \
    requests httpx 'numpy<2' scipy scikit-learn joblib \
    python-json-logger prometheus-client threadpoolctl

# Copier tout le code
COPY . /app

# === ENTRAÎNER LES MODÈLES ML PENDANT LE BUILD ===
RUN mkdir -p /app/models && \
    python train_ml_models.py \
      --data data/csic_database.csv \
      --save models/ml_engine.pkl \
    || echo "ML training skipped (dataset may be missing, will use fallback)"

# Nettoyage léger : supprimer uniquement les caches (garder TOUTES les .so)
# On ne fait PAS apt-get purge/autoremove pour éviter de casser numpy/scipy
RUN rm -rf /var/lib/apt/lists/* /root/.cache/pip /tmp/*

ENV PYTHONUNBUFFERED=1
ENV BEEWAF_MODEL_PATH=/app/models/ml_engine.pkl
ENV BEEWAF_TRAIN_DATA=/app/data/csic_database.csv
ENV ML_MODE=advanced

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
